# ClaimIQ Enterprise — environment template.
#
#   cp .env.example .env
#
# Then set every value marked REQUIRED. The stack refuses to start without
# them rather than falling back to an insecure default.
#
# This file is a template and contains no real secrets. Never commit `.env`.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=false

# Hostnames this server answers to. Add the LAN hostname or IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# 127.0.0.1 keeps the stack local. Set 0.0.0.0 to publish on the LAN — do this
# deliberately, and only behind a firewall.
BIND_ADDRESS=127.0.0.1

# Host ports. Offset from the defaults so the legacy prototype can run
# alongside this stack without collision.
HTTP_HOST_PORT=8080
HTTPS_HOST_PORT=8443
BACKEND_HOST_PORT=8100
POSTGRES_HOST_PORT=5532
REDIS_HOST_PORT=6479
OLLAMA_HOST_PORT=11534

IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# Leave false for a plain-HTTP deployment on an isolated LAN. Set all three
# true once certificates are in docker/nginx/certs.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Required when the browser origin differs from the API origin — e.g. running
# the Vite dev server against a containerised backend.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=claimiq
POSTGRES_USER=claimiq
POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Hardware profile
# ---------------------------------------------------------------------------
# cpu | gpu-entry | gpu-mid | gpu-high
#
# Selects the torch build at image build time and the default model set at
# runtime. `cpu` is the safe default and works everywhere. See ADR 0007 and
# docs/DEPLOYMENT.md before changing.
HARDWARE_PROFILE=cpu

# ---------------------------------------------------------------------------
# AI models
# ---------------------------------------------------------------------------
# Intentionally blank. Models are configured by an administrator in the
# application, not baked into deployment config — the system detects what the
# local Ollama instance has available and offers those. Setting a value here
# only seeds an empty installation.
#
# Suggested starting points (must be pulled into Ollama first):
#   DEFAULT_LLM_MODEL=qwen2.5:14b-instruct     (gpu-mid and above)
#   DEFAULT_LLM_MODEL=qwen2.5:7b-instruct      (gpu-entry)
#   DEFAULT_LLM_MODEL=qwen2.5:3b-instruct      (cpu)
DEFAULT_LLM_MODEL=
DEFAULT_EMBEDDING_MODEL=
DEFAULT_RERANKER_MODEL=

# Must match the embedding model's output width. Changing this after documents
# have been embedded requires a re-embed — the migration will refuse to run
# otherwise rather than silently corrupt the index.
#   BGE-M3       -> 1024
#   all-MiniLM   -> 384
EMBEDDING_DIMENSIONS=1024

OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_LEXICAL_CANDIDATES=50
RETRIEVAL_VECTOR_CANDIDATES=50
RETRIEVAL_RERANK_CANDIDATES=30
RETRIEVAL_FINAL_CHUNKS=12
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_PER_DOCUMENT=4

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
INGESTION_CONCURRENCY=2
# Keep at 1 unless the GPU has headroom for concurrent inference.
AI_CONCURRENCY=1
DEFAULT_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=50
CELERY_SOFT_TIME_LIMIT=3600
CELERY_TIME_LIMIT=4200

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=536870912
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152

# ---------------------------------------------------------------------------
# Sessions and passwords
# ---------------------------------------------------------------------------
SESSION_COOKIE_AGE=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=false
PASSWORD_MIN_LENGTH=12

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
THROTTLE_AUTH=10/min
THROTTLE_UPLOAD=60/hour
THROTTLE_AI=120/hour
THROTTLE_SEARCH=600/hour

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# json for production; console is easier to read during development.
LOG_FORMAT=json

REDIS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# Local development without Docker
# ---------------------------------------------------------------------------
# Read only by config.settings.dev, which `manage.py` uses by default and
# which loads this file itself. docker-compose sets its own values for these
# and ignores the lines below.
#
# POSTGRES_HOST must point at your local server rather than the compose
# service name.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
#
# Ollama on this machine rather than the compose service.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Redis is optional locally. When false, an in-process cache and database
# sessions are used, and background tasks run inline — so an upload blocks
# while its document is processed rather than queueing into nothing.
# USE_REDIS=false
# CELERY_TASK_ALWAYS_EAGER=true
#
# Readable log lines for a terminal instead of JSON.
# LOG_FORMAT=console
