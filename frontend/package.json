{
  "name": "claimiq-enterprise-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClaimIQ Enterprise — offline Contract & Claims Intelligence Platform (web client)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "coverage": "vitest --run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"*.{js,json,md}\""
  },
  "dependencies": {
    "@primevue/themes": "4.5.4",
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "4.5.4",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.3.0"
  }
}
